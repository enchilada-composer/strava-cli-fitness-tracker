# Strava API credentials - COPY THIS FILE TO .env
# 1. Create a new application at https://www.strava.com/settings/api
# 2. Copy this file to .env
# 3. Fill in your Client ID and Client Secret
# 4. The script will automatically handle token refresh and save the tokens

# Get these from your Strava application settings
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# These will be automatically managed by the script
# Access token for API requests (valid for ~3.7 hours)
STRAVA_ACCESS_TOKEN=your_access_token_here
# Refresh token for obtaining new access tokens
STRAVA_REFRESH_TOKEN=your_refresh_token_here
# Token expiration timestamp
STRAVA_EXPIRES_AT=0

# Authorization URL (you'll need to visit this URL to authorize the app)
# Replace your_client_id_here with your actual client ID
AUTH_URL=https://www.strava.com/oauth/authorize?client_id=your_client_id_here&response_type=code&redirect_uri=http://localhost/exchange_token&approval_prompt=force&scope=read,activity:read_all

# IMPORTANT: Never commit this file to version control with your actual credentials!


