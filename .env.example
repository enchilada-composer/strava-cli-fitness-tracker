# Strava API credentials - COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# Create a new application at https://www.strava.com/settings/api

STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# The STRAVA_ACCESS_TOKEN will be automatically generated after authorization
# You don't need to fill this in manually
STRAVA_ACCESS_TOKEN=YOUR_ACCESS_TOKEN_HERE
